forge Pixel { r: u8 = 0  g: u8 = 0  b: u8 = 255 }
pulse brighten(p: Pixel, by: u8) -> Pixel {
    return spawn Pixel { r: p.r + by, g: p.g + by, b: p.b + by }
}
pulse checksum(n: u8) -> u32 {
    shadow acc: u32 = 0
    for i in 0..n { acc += cast(i, u32) * 31u32 }
    return acc
}
pulse main() {
    atom p = spawn Pixel { r: 250, g: 10 }
    atom q = brighten(p, 10)
    beam f"{q.r} {q.g} {q.b}"
    beam checksum(10u8)
    shadow h: u64 = 14695981039346656037
    for i in 0..4 { h = (h ^ cast(i, u64)) * 1099511628211u64 }
    beam h
    shadow m: i16 = 100
    m *= 400
    beam m
    m >>= 2
    beam m
    atom bits: u8 = 0b1011_0001
    beam bits & 0x0F
    beam bits | 0x0E
    beam bits ^ 0xFF
    beam ~bits
}
